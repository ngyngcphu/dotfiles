# ~/.zshrc (linked from ~/dotfiles/zsh/zshrc). Machine-specific or private settings go in ~/.zshrc.local.

# Powerlevel10k instant prompt. Keep near the top; anything that prompts for input goes above it.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# PATH: earlier entries win. Homebrew itself is added in ~/.zprofile, Rust in ~/.zshenv.
# Set before oh-my-zsh: its plugins only load for commands they can find.
export BUN_INSTALL="$HOME/.bun"
export PNPM_HOME="$HOME/Library/pnpm"
path=(
  "$HOMEBREW_PREFIX/opt/mysql-client/bin"
  "$HOME/.local/bin" # claude, uv
  "$HOMEBREW_PREFIX/opt/openjdk/bin" # java (keg-only)
  "$PNPM_HOME"       # pnpm global packages
  "$HOMEBREW_PREFIX/opt/libpq/bin"
  "$BUN_INSTALL/bin"
  $path
  "$HOME/go/bin"     # go install
)
typeset -U path # drop duplicates

# oh-my-zsh (theme and plugins are cloned by install.sh)
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="powerlevel10k/powerlevel10k"
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE="fg=#5c6370"
# Plugins add tab completion and aliases for each tool; list a plugin's aliases with `als -g <plugin>`
# or see ~/.oh-my-zsh/plugins/<plugin>/README.md. gh, brew, helm, argocd, colima, pnpm, k6, buf, psql,
# mysql, rg, fd and jq complete through Homebrew's completion files without a plugin.
plugins=(
  git            # g, gst, gco, gp, gl, ...
  brew           # bubo (outdated), bubu (update + upgrade), ...
  kubectl        # kgp (get pods), kaf (apply -f), kl (logs), keti (exec -it), ...
  docker         # dps, dpsa, dils (images), dxcit (exec -it), dlo (logs), ...
  docker-compose # dco, dcup, dcdn, dcl, ...
  terraform      # tf, tfi (init), tfp (plan), tfa (apply), tfv (validate), ...
  aws            # aws completion, asp (switch profile), asr (switch region), agp/agr (show current)
  golang         # gob (build), got (test), gor (run), gom (mod), ...
  rust           # cargo and rustup completion
  uv             # uvr (run), uva (add), uvs (sync), ...
  npm            # npmg (install -g), npmS, npmD, ...
  yarn           # y, ya (add), yad, yrun, ...
  mvn            # mvnci (clean install), mvnct, ...
  pip            # pip completion, pipi, pipu, ...
  python         # py, pyfind, pyclean, mkv (create venv), vrun (activate), ...
  redis-cli      # redis-cli completion
  zsh-autosuggestions
  zsh-syntax-highlighting # must stay last
)
# completion cache in ~/.cache/zsh instead of the home folder
ZSH_COMPDUMP="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/zcompdump-${ZSH_VERSION}"
mkdir -p "${ZSH_COMPDUMP:h}"
source "$ZSH/oh-my-zsh.sh"

# keep shell history free of duplicates (only the most recent copy of a command is kept)
setopt HIST_IGNORE_ALL_DUPS HIST_SAVE_NO_DUPS

# prompt (run `p10k configure` to regenerate ~/dotfiles/zsh/p10k.zsh)
[[ -f ~/.p10k.zsh ]] && source ~/.p10k.zsh

# Completion for tools without an oh-my-zsh plugin, cached the way the plugins do it:
# generated on first use, then refreshed in the background so upgrades are picked up.
for _cmd in atlas lazygit; do
  (( $+commands[$_cmd] )) || continue
  if [[ ! -s "$ZSH_CACHE_DIR/completions/_$_cmd" ]]; then
    $_cmd completion zsh >| "$ZSH_CACHE_DIR/completions/_$_cmd" 2>/dev/null
    autoload -Uz _$_cmd && compdef _$_cmd $_cmd
  else
    { $_cmd completion zsh >| "$ZSH_CACHE_DIR/completions/._$_cmd" 2>/dev/null &&
      mv -f "$ZSH_CACHE_DIR/completions/._$_cmd" "$ZSH_CACHE_DIR/completions/_$_cmd" } &|
  fi
done
unset _cmd
# keep the literal ".bun/_bun" path: `bun upgrade` looks for it and appends its own line otherwise
[[ -s "$HOME/.bun/_bun" ]] && source "$HOME/.bun/_bun"

# kubectl against ~/.kube/config. A function, not an alias, so it can't be overridden by a KUBECONFIG
# exported elsewhere; it replaces the kubectl plugin's `alias k=kubectl` (unalias first, or zsh would
# expand the alias inside the definition).
unalias k 2>/dev/null
k() { KUBECONFIG=$HOME/.kube/config kubectl "$@" }
compdef k=kubectl

# private, machine-specific settings (not in the repo)
[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local
